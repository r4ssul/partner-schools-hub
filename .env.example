VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_TIMEZONE=Asia/Tokyo
VITE_ENABLE_LOCAL_PREVIEW=false
VITE_USE_HASH_ROUTER=false

# Temporary showcase only. Never use these browser-visible values as production authentication.
# VITE_PREVIEW_LOGIN_EMAIL=
# VITE_PREVIEW_LOGIN_PASSWORD=

# Edge Function secrets (configure with `supabase secrets set`, never expose in Vite)
# SUPABASE_SECRET_KEY=
# RESEND_API_KEY=
# APP_URL=http://localhost:5173
# DISPATCH_SECRET=
# EMAIL_FROM=Partner Schools Hub <notifications@example.com>
